---
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const mods = import.meta.glob("../../contenido/decisiones/*.md", { eager: true });
  return Object.values(mods).map((m: any) => ({
    params: { slug: m.frontmatter.slug },
    props: { mod: m },
  }));
}

const { mod } = Astro.props;
const { Content, frontmatter } = mod;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const num = frontmatter.slug.slice(0, 4);
---

<Base titulo={`${frontmatter.titulo} — FER`} descripcion={frontmatter.titulo}>
  <div class="envoltura prosa">
    <p class="rotulo">
      <a href={`${base}/decisiones/`} style="color:inherit">Decisiones</a> / {num}
    </p>
    <h1>{frontmatter.titulo.replace(/^\d{4}\s+—\s+/, "")}</h1>
    <Content />
  </div>
</Base>
