---
import Base from "../layouts/Base.astro";
import Icono from "../components/Icono.astro";
const repo = "https://github.com/Factura-Facil/estandar-fe-retail-fer";
---

<Base
  titulo="Validador — FER 1.1.1"
  descripcion="Comprueba cómo un receptor extrae la Orden de Compra y el Código de Barras de cualquier factura electrónica conforme a FER 1.1.1. Funciona en el navegador, sin subir archivos."
>
  <section class="cabecera cabecera--tool">
    <div class="envoltura envoltura--prosa">
      <p class="rotulo">Herramienta</p>
      <h1>Comprueba qué extrae un receptor FER</h1>
      <p class="cabecera__bajada">
        Pega el contenido del campo de notas de tu factura o sube el XML completo. La
        herramienta muestra exactamente lo que extraería un receptor conforme a FER.
      </p>
      <p class="cabecera__nota">
        Corre completo en tu navegador. Ni el campo ni el archivo salen de tu máquina.
      </p>
    </div>
  </section>

  <div class="envoltura envoltura--prosa prosa tool">
    <div class="modos" role="tablist" aria-label="Modo de revisión">
      <button type="button" class="modo" data-modo="campo" role="tab" aria-selected="true">
        Un campo
      </button>
      <button type="button" class="modo" data-modo="xml" role="tab" aria-selected="false">
        Un XML completo
      </button>
    </div>

    {/* La garantía de privacidad se repite aquí, al lado del input, y no solo arriba:
        es donde el usuario decide si pega datos de una factura real. */}
    <p class="tool__privado">
      <Icono nombre="escudo" tamano={13} /> Los datos no salen de tu navegador
    </p>

    <section id="panel-campo">
      <label class="tool__rotulo" for="entrada"
        >Campo de notas de la factura (<code>dInfEmFE</code>)</label
      >
      <textarea
        id="entrada"
        class="tool__campo"
        spellcheck="false"
        autocapitalize="off"
        autocomplete="off"
        rows="4">Gracias por su compra. #FER1# oc=4500000001 | ref=TIENDA RETAIL X #FER1#</textarea
      >

      <div class="tool__fila">
        <div class="tool__radios" role="radiogroup" aria-label="Nivel del campo">
          <label
            ><input type="radio" name="nivel" value="documento" checked /> Cabecera del
            documento (B29)</label
          >
          <label
            ><input type="radio" name="nivel" value="item" /> Línea de producto / ítem
            (C19)</label
          >
        </div>
      </div>

      {/* El rótulo de esta fila lo pone el script junto a los botones: si el JS no
          corre no quedan ni los ejemplos ni un título huérfano anunciándolos. */}
      <div class="tool__ejemplos" id="ejemplos"></div>

      <div class="tool__salida">
        <p class="tool__perfil" id="perfil"></p>
        <div class="campo">
          <p class="campo__etiqueta">el campo tal como llega</p>
          <p class="campo__cadena" id="marcado"></p>
          <p class="campo__paso">Lo que extrae el receptor</p>
          <dl class="campo__lectura" id="extraido"></dl>
        </div>
        <p class="campo__nota" id="nota"></p>
        <p class="tool__sigue" id="sigue"></p>
      </div>
    </section>

    <section id="panel-xml" hidden>
      <div class="zona" id="zona">
        <Icono nombre="subida" tamano={30} />
        <p class="zona__texto">
          Arrastra un XML aquí, o
          <label class="zona__boton">
            elige un archivo
            <input type="file" id="archivo" accept=".xml,text/xml,application/xml" />
          </label>
        </p>
        <p class="zona__nota">
          Si no tienes uno a mano, hay un
          <a href={`${repo}/blob/main/conformidad/xml/ejemplo-completo.xml`}
            >ejemplo en el repositorio</a
          >.
        </p>
      </div>

      <div id="salida-xml"></div>
    </section>

    <h2>Cómo funciona</h2>
    <p>
      Usa la misma implementación de referencia publicada en el repositorio, sin
      modificaciones. Lo que ves aquí es lo que haría un receptor que la copie tal cual.
    </p>
    <details class="detalle">
      <summary>Detalle técnico</summary>
      <p>
        La página importa <code>referencia/javascript/fer.js</code> del repositorio, sin
        tocarlo. Si el validador y la especificación discrepan, la especificación manda y
        es un defecto de la implementación: <a href={`${repo}/issues`}>abre un issue</a>.
      </p>
      <p>
        Al revisar un XML se recorre el documento buscando los campos <code>dInfEmFE</code
        > por nombre local, así que funciona con o sin declaración de namespace y sin
        depender de la posición exacta de los nodos.
      </p>
    </details>
    <p>
      Al subir un XML completo, además de la lectura se revisa <em>cómo está escrito</em> el
      campo: lo que los casos de conformidad no pueden ejercitar, porque depende de la
      emisión y no de la lectura. El informe clasifica cada hallazgo en tres grados:
    </p>
    <ul class="grados">
      <li class="grados--error">
        <span class="grados__pastilla">error</span>
        un defecto de emisión que hace que el dato no llegue o llegue ambiguo: un bloque que
        abre y no cierra, una clave duplicada, un <code>oc</code> con más de una Orden de Compra,
        o un campo que pasa los 5.000 caracteres de la Ficha Técnica.
      </li>
      <li class="grados--aviso">
        <span class="grados__pastilla">aviso</span>
        una recomendación de §4.3 o §4.4 sin cumplir: el bloque no está al inicio del campo,
        o pasa de 512 caracteres. El documento se lee igual, pero queda expuesto al recorte
        silencioso que describe §4.4.
      </li>
      <li class="grados--nota">
        <span class="grados__pastilla">nota</span>
        información, no defecto: claves fuera del registro, que un receptor conforme ignora,
        o campos que se leen con el perfil heredado.
      </li>
    </ul>
  </div>
</Base>

<script>
  import { leer } from "../contenido/fer.js";
  import { revisarXml } from "../lib/revisar-xml.js";

  const NORMATIVAS: Record<string, string[]> = { documento: ["oc", "ref"], item: ["cbar"] };

  const EJEMPLOS: [string, string, string][] = [
    ["bloque simple", "documento", "#FER1# oc=4500000001 | ref=TIENDA RETAIL X #FER1#"],
    ["con texto libre", "documento", "Aviso al cliente. #FER1# oc=4500000001 #FER1# Válido 30 días."],
    ["ceros a la izquierda", "documento", "#FER1# oc=0004500001 #FER1#"],
    ["clave duplicada", "documento", "#FER1# oc=4500000001 | oc=4500000999 #FER1#"],
    ["sin cerrar", "documento", "#FER1# oc=4500000001"],
    ["mayúsculas", "documento", "#FER1# OC=4500000001 #FER1#"],
    ["versión superior", "documento", "#FER2# oc=4500000001 | ccosto=1200 #FER2#"],
    ["perfil heredado", "documento", "Orden de compra: 4500000001 TIENDA RETAIL X"],
    ["código de barras", "item", "Producto refrigerado. #FER1# cbar=7600000000001 #FER1#"],
    ["peso variable", "item", "#FER1# cbar=2000123456789 #FER1#"],
    ["heredado en ítem", "item", "7600000000001"],
  ];

  const BLOQUE = /#FER(\d)#([\s\S]*?)#FER\1#/;

  const REPO = "https://github.com/Factura-Facil/estandar-fe-retail-fer";
  const SPEC = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/spec/`;

  const $ = (id: string) => document.getElementById(id)!;
  function el(tag: string, clase?: string, texto?: string) {
    const n = document.createElement(tag);
    if (clase) n.className = clase;
    if (texto !== undefined) n.textContent = texto;
    return n;
  }
  function enlace(href: string, texto: string) {
    const a = document.createElement("a");
    a.href = href;
    a.textContent = texto;
    return a;
  }

  for (const b of document.querySelectorAll<HTMLButtonElement>(".modo")) {
    b.addEventListener("click", () => {
      for (const otro of document.querySelectorAll<HTMLButtonElement>(".modo")) {
        otro.setAttribute("aria-selected", String(otro === b));
      }
      ($("panel-campo") as HTMLElement).hidden = b.dataset.modo !== "campo";
      ($("panel-xml") as HTMLElement).hidden = b.dataset.modo !== "xml";
    });
  }

  const entrada = $("entrada") as HTMLTextAreaElement;

  function nivelActual(): "documento" | "item" {
    const sel = document.querySelector<HTMLInputElement>('input[name="nivel"]:checked');
    return (sel?.value as "documento" | "item") ?? "documento";
  }

  function pintarMarcado(destino: Element, valor: string, esFer: boolean) {
    destino.replaceChildren();
    if (!valor.trim()) {
      destino.append(el("span", "tool__vacio", "El campo está vacío."));
      return;
    }
    const m = esFer ? BLOQUE.exec(valor) : null;
    if (!m) {
      destino.append(el("span", "campo__libre", valor));
      return;
    }
    const antes = valor.slice(0, m.index);
    const despues = valor.slice(m.index + m[0].length);
    if (antes) destino.append(el("span", "campo__libre", antes));
    destino.append(el("span", "marca", m[0]));
    if (despues) destino.append(el("span", "campo__libre", despues));
  }

  /**
   * Un campo sin bloque no es un error del usuario: es el perfil heredado de §7, que la
   * convención reconoce. El mensaje lo dice con esas palabras para que nadie lea una
   * pantalla en blanco y crea que pegó mal el contenido.
   */
  function pintarNota(esFer: boolean, vacio: boolean) {
    const nota = $("nota");
    nota.replaceChildren();
    if (vacio) {
      nota.append("Pega el contenido de un campo, o carga uno de los ejemplos de arriba.");
      return;
    }
    if (esFer) {
      nota.append(
        "El receptor extrae solo lo marcado. Todo lo demás es uso libre del emisor."
      );
      return;
    }
    nota.append(
      "No se encontró un bloque FER en este campo. No es un error: se aplicó la lectura del perfil heredado, la ruta que la convención reconoce para emisores que todavía no escriben el bloque — ",
      enlace(`${SPEC}#7-perfil-heredado`, "ver §7"),
      "."
    );
  }

  /**
   * Qué hacer con el resultado. El validador lee un campo, no audita una implementación:
   * que una cadena se lea bien no dice nada sobre la conformidad de quien la emitió, y
   * por eso el enlace a los casos se ofrece como el paso siguiente y no como un veredicto.
   */
  function pintarSigue(esFer: boolean, extrajo: boolean, vacio: boolean) {
    const sigue = $("sigue");
    sigue.replaceChildren();
    if (vacio) return;
    if (esFer && extrajo) {
      sigue.append(
        "Este campo se lee como define la convención. Para verificar una implementación entera, y no un campo suelto, están los ",
        enlace(`${REPO}/blob/main/conformidad/casos.json`, "20 casos de conformidad →")
      );
    } else if (esFer) {
      sigue.append(
        "Hay bloque, pero no trae ninguna clave del registro para este nivel. ",
        enlace(`${SPEC}#4-emisión`, "Reglas de emisión →")
      );
    } else if (extrajo) {
      sigue.append(
        "El dato llegó, pero depende de la forma del texto que lo rodea. Etiquetarlo dentro del bloque quita esa dependencia. ",
        enlace(`${SPEC}#4-emisión`, "Reglas de emisión →")
      );
    } else {
      sigue.append(
        "No se extrajo ninguna clave del registro. Si esperabas un dato aquí, revisa cómo se escribe el bloque. ",
        enlace(`${SPEC}#4-emisión`, "Reglas de emisión →")
      );
    }
  }

  function actualizarCampo() {
    const valor = entrada.value;
    const vacio = !valor.trim();
    const nivel = nivelActual();
    const r = leer(valor, nivel);
    const esFer = r.perfil === "fer";

    $("perfil").replaceChildren(
      document.createTextNode("perfil "),
      el("b", undefined, esFer ? `bloque #FER${r.versionEsquema}#` : "heredado")
    );

    pintarMarcado($("marcado"), valor, esFer);

    const extraido = $("extraido");
    extraido.replaceChildren();
    const conocidas = NORMATIVAS[nivel];
    const presentes = conocidas.filter((k) => k in r.datos);
    const otras = Object.keys(r.datos).filter((k) => !conocidas.includes(k));

    if (presentes.length === 0) {
      extraido.append(
        el("dt", undefined, "extraído"),
        el("dd", "tool__vacio", "ninguna clave del registro")
      );
    } else {
      for (const k of presentes) {
        extraido.append(el("dt", undefined, k), el("dd", undefined, r.datos[k]));
      }
    }
    if (otras.length) {
      extraido.append(
        el("dt", undefined, "ignoradas"),
        el("dd", "tool__vacio", otras.join(", ") + " · fuera del registro")
      );
    }
    if (r.textoLibre) {
      extraido.append(el("dt", undefined, "texto libre"), el("dd", "tool__vacio", r.textoLibre));
    }

    pintarNota(esFer, vacio);
    pintarSigue(esFer, presentes.length > 0, vacio);
  }

  const ejemplos = $("ejemplos");
  ejemplos.append(el("span", "tool__ejemplos-rotulo", "O prueba un caso:"));
  for (const [etiqueta, nivel, cadena] of EJEMPLOS) {
    const b = document.createElement("button");
    b.type = "button";
    b.className = "tool__ejemplo";
    b.textContent = etiqueta;
    b.addEventListener("click", () => {
      entrada.value = cadena;
      const radio = document.querySelector<HTMLInputElement>(
        `input[name="nivel"][value="${nivel}"]`
      );
      if (radio) radio.checked = true;
      actualizarCampo();
      entrada.focus();
    });
    ejemplos.append(b);
  }

  entrada.addEventListener("input", actualizarCampo);
  for (const r of document.querySelectorAll('input[name="nivel"]')) {
    r.addEventListener("change", actualizarCampo);
  }
  actualizarCampo();

  function listaAvisos(avisos: any[]) {
    const ul = el("ul", "avisos");
    for (const a of avisos) {
      const li = el("li", `aviso--${a.grado}`);
      li.append(el("span", "aviso__grado", a.grado));
      li.append(el("span", "aviso__texto", a.texto));
      li.append(el("span", "aviso__ref", a.ref));
      ul.append(li);
    }
    return ul;
  }

  function pintarXml(r: any) {
    const salida = $("salida-xml");
    salida.replaceChildren();

    if (!r.ok) {
      salida.append(el("p", "xml__error", r.error));
      return;
    }

    const { errores, avisos: nAvisos, notas } = r.resumen;
    const resumen = el(
      "p",
      "xml__resumen",
      errores === 0 && nAvisos === 0
        ? "Sin errores ni avisos."
        : `${errores} error(es) · ${nAvisos} aviso(s) · ${notas} nota(s)`
    );
    resumen.classList.add(
      errores ? "xml__resumen--error" : nAvisos ? "xml__resumen--aviso" : "xml__resumen--ok"
    );
    salida.append(resumen);

    salida.append(el("h3", undefined, "Nivel de documento"));
    if (!r.documento) {
      salida.append(el("p", "tool__vacio", "No hay campo dInfEmFE fuera de gItem."));
    } else {
      const d = r.documento;
      const caja = el("div", "campo");
      caja.append(el("p", "campo__etiqueta", `perfil ${d.lectura.perfil}`));
      const cadena = el("p", "campo__cadena");
      pintarMarcado(cadena, d.campo, d.lectura.perfil === "fer");
      caja.append(cadena);
      const dl = el("dl", "campo__lectura");
      for (const k of ["oc", "ref"]) {
        dl.append(
          el("dt", undefined, k),
          el("dd", d.lectura.datos[k] ? undefined : "tool__vacio", d.lectura.datos[k] ?? "ausente")
        );
      }
      caja.append(dl);
      salida.append(caja);
    }

    salida.append(
      el("h3", undefined, `Ítems · ${r.items.length} de ${r.totalItems} con campo`)
    );
    if (r.items.length === 0) {
      salida.append(el("p", "tool__vacio", "Ningún ítem trae dInfEmFE."));
    } else {
      const tabla = el("table", "xml__tabla");
      const thead = el("thead");
      const trh = el("tr");
      for (const c of ["#", "dCodProd", "cbar", "perfil"]) trh.append(el("th", undefined, c));
      thead.append(trh);
      tabla.append(thead);
      const tbody = el("tbody");
      for (const i of r.items) {
        const tr = el("tr");
        tr.append(el("td", undefined, i.secItem ?? "—"));
        tr.append(el("td", undefined, i.codProd ?? "—"));
        const cbar = i.lectura.datos.cbar;
        tr.append(el("td", cbar ? "xml__dato" : "tool__vacio", cbar ?? "ausente"));
        tr.append(el("td", "xml__perfil", i.lectura.perfil));
        tbody.append(tr);
      }
      tabla.append(tbody);
      salida.append(tabla);
    }

    const todos = [
      ...r.globales,
      ...(r.documento ? r.documento.avisos : []),
      ...r.items.flatMap((i: any) =>
        i.avisos.map((a: any) => ({ ...a, texto: `Ítem ${i.secItem ?? "?"}: ${a.texto}` }))
      ),
    ];
    if (todos.length) {
      salida.append(el("h3", undefined, "Revisión"));
      salida.append(listaAvisos(todos));
    }
  }

  function leerArchivo(f: File) {
    if (f.size > 8 * 1024 * 1024) {
      pintarXml({ ok: false, error: "El archivo pesa más de 8 MB." });
      return;
    }
    const fr = new FileReader();
    fr.onload = () => pintarXml(revisarXml(String(fr.result)));
    fr.onerror = () => pintarXml({ ok: false, error: "No se pudo leer el archivo." });
    fr.readAsText(f, "utf-8");
  }

  const archivo = $("archivo") as HTMLInputElement;
  archivo.addEventListener("change", () => {
    const f = archivo.files?.[0];
    if (f) leerArchivo(f);
  });

  const zona = $("zona");
  for (const ev of ["dragenter", "dragover"]) {
    zona.addEventListener(ev, (e) => {
      e.preventDefault();
      zona.classList.add("zona--activa");
    });
  }
  for (const ev of ["dragleave", "drop"]) {
    zona.addEventListener(ev, (e) => {
      e.preventDefault();
      zona.classList.remove("zona--activa");
    });
  }
  zona.addEventListener("drop", (e) => {
    const f = (e as DragEvent).dataTransfer?.files?.[0];
    if (f) leerArchivo(f);
  });
</script>
