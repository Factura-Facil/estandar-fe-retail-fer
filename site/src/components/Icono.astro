---
/**
 * Los cinco íconos del sitio, en línea. Son trazos de 1.5 sobre una caja de 20 (24 en
 * el de subida, que se compone más grande), sin relleno: acompañan un titular o un
 * rótulo y nunca cargan significado por sí solos, así que van con aria-hidden.
 */
interface Props {
  nombre: "documento" | "bloque" | "verificado" | "subida" | "escudo";
  tamano?: number;
}
const { nombre, tamano = 20 } = Astro.props;
const caja = nombre === "subida" ? 24 : 20;
---

<svg
  width={tamano}
  height={tamano}
  viewBox={`0 0 ${caja} ${caja}`}
  fill="none"
  stroke="currentColor"
  stroke-width={nombre === "subida" ? 1.6 : 1.5}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {/* Un campo que ya está ahí: el documento con sus líneas de texto. */}
  {
    nombre === "documento" && (
      <>
        <rect x="4.25" y="2.5" width="11.5" height="15" rx="2" />
        <path d="M7.25 7h5.5M7.25 10h5.5M7.25 13h3" />
      </>
    )
  }

  {/* Un bloque que delimita: dos centinelas y el dato en medio. */}
  {
    nombre === "bloque" && (
      <>
        <path d="M7.5 3.75H5.75A1.75 1.75 0 0 0 4 5.5v9a1.75 1.75 0 0 0 1.75 1.75H7.5" />
        <path d="M12.5 3.75h1.75A1.75 1.75 0 0 1 16 5.5v9a1.75 1.75 0 0 1-1.75 1.75H12.5" />
        <path d="M8.25 10h3.5" />
      </>
    )
  }

  {/* Una regla que los lee todos: verificado. */}
  {
    nombre === "verificado" && (
      <>
        <circle cx="10" cy="10" r="7" />
        <path d="M6.9 10.2l2.1 2.1 4.1-4.5" />
      </>
    )
  }

  {/* Subir un XML. */}
  {
    nombre === "subida" && (
      <>
        <path d="M12 15.5V4m0 0L8.25 7.75M12 4l3.75 3.75" />
        <path d="M4 15v3a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-3" />
      </>
    )
  }

  {/* Nada sale del navegador. */}
  {
    nombre === "escudo" && (
      <>
        <path d="M10 2.75l5.75 2.25v4.75c0 3.3-2.45 5.7-5.75 6.5-3.3-.8-5.75-3.2-5.75-6.5V5L10 2.75z" />
      </>
    )
  }
</svg>
